{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build SDL2 + OpenGL",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}",
                "`sdl2-config --cflags --libs`",
                "-lGL"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Build SDL2/OpenGL program"
        },
        {
            "label": "Run SDL2 Program",
            "type": "shell",
            "command": "${fileDirname}/${fileBasenameNoExtension}",
            "group": "none"
        }
    ]
}
